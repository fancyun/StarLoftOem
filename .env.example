# ========================
# 环境变量配置文件（仅密钥类 + 基础设施自举参数）
# ========================
# 本文件只保留两类配置：
#   1) 密钥类：数据库/Redis 口令、JWT、数据加密、第三方密钥/AppKey/Secret、支付证书；
#   2) 基础设施自举：服务监听、数据库与 Redis 连接、目录路径、端口、回调来源白名单。
# 其余非密钥类业务配置（单价、开关、AppID、商户号、地域、接口基址、提成比例等）不在本文件维护，
# 只存于数据库（系统库 setting 表 + 各产品库 product_config 表），在后台「系统设置 / 产品配置」在线维护。

# ================
# 1. 服务器配置
# ================
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
GIN_MODE=release

# ================
# 2. 数据库连接（本地 docker-compose 编排的 MySQL 容器）
# ================
# 后端连接 docker-compose 中的 mysql 容器（host 用服务名 mysql，仅容器内网访问，
# 数据持久化在宿主 ./data/mysql）。DB_USER/DB_PASSWORD 即 MySQL root 账号密码，
# 数据库（分库 + 表结构 + 种子数据）由后端启动时迁移/AutoMigrate 自动创建。
DB_HOST=mysql
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_root_password_here
DB_MAX_IDLE_CONNS=50
DB_MAX_OPEN_CONNS=200

# ================
# 3. Redis（Docker 本地 Redis 容器）
# ================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_strong_password_here
REDIS_DB=0
REDIS_POOL_SIZE=50

# ================
# 4. JWT 与数据加密
# ================
JWT_SECRET=your_generated_jwt_secret_32_bytes
JWT_ADMIN_SECRET=your_generated_admin_jwt_secret_32_bytes
# 敏感字段数据加密密钥（必须恰好 32 字节，如 openssl rand -base64 24 | head -c 32）
# 生成后不可随意更换，否则历史密文无法解密
DATA_ENCRYPT_KEY=0123456789abcdef0123456789abcdef
JWT_EXPIRE_HOURS=24

# ================
# 5. 目录与访问控制
# ================
# 日志目录（容器内 /app/logs，bind mount 到宿主 ./data/logs）
# 需保证宿主目录属主为 uid 1000（app）可写：mkdir -p ./data/logs && chown -R 1000:1000 ./data/logs
LOG_DIR=/app/logs
# 用户上传的营业执照/身份证等资质图片存储目录（容器内 /app/uploads，bind mount 到宿主 ./data/uploads）
# 需保证宿主目录属主为 uid 1000（app）可写：mkdir -p ./data/uploads && chown -R 1000:1000 ./data/uploads
UPLOAD_DIR=/app/uploads
# 人脸核验认证媒体（照片/视频）存储目录（容器内 /app/media，bind mount 到宿主 ./data/media）。
# 独立于用户上传目录：认证媒体只经 API（/v1/fv/media、/v1/fv/best-img）以 base64 下发，不走静态路由。
# 需保证宿主目录属主为 uid 1000（app）可写：mkdir -p ./data/media && chown -R 1000:1000 ./data/media
MEDIA_DIR=/app/media
# 资质图读取：对外地址带访问签名（?e=过期时间&s=签名，HMAC 密钥取自 JWT_SECRET），
# 凭有效签名任意来源可读（不限制 IP），页面展示与上游拉图均走此通道；
# 另放行「已登录管理员（全部图片）」与「上传者本人（控制台用户）」。
UPLOAD_URL_TTL_DAYS=365
# 上游回调来源 IP 白名单（/v1/callback/*：上游 StarLoft 平台推送、支付宝、微信通知）。
# 支持精确 IP 或 CIDR 段，英文逗号分隔。建议将各上游服务器出口 IP 在此放行，防止伪造回调；
# 未配置时回调端点不校验来源（兼容现状，仅记录提示日志）。
CALLBACK_TRUST_IPS=

# ================
# 6. 第三方密钥
# ================
# 非密钥的 AppID / 商户号 / 地域 / 接口基址 / 开关 / 单价等一律在后台「系统设置」维护，不写在本文件。
# 6.1 上游 StarLoft 平台开放 API（OEM 系统的唯一上游：短信产品、人脸核验产品、系统验证码短信、账户实名扫脸）
# 平台签发的 API 密钥对；OEM 账号须已实名（短信需个人实名，人脸核验需企业实名），
# 并在 StarLoft 侧报备平台验证码短信的签名与模板（见后台「系统设置」）。
STARLOFT_API_KEY=your_starloft_api_key
STARLOFT_API_SECRET=your_starloft_api_secret

# 6.2 腾讯云账号密钥（供天御验证码、企业工商四要素核验与法人扫脸备选通道共用）
TENCENT_SECRET_ID=your_tencent_secret_id
TENCENT_SECRET_KEY=your_tencent_secret_key
TENCENT_CAPTCHA_SECRET=your_captcha_secret

# 6.3 极验行为验证码（后台「系统设置」可切换验证码通道）
GEETEST_CAPTCHA_KEY=your_geetest_captcha_key

# 6.4 阿里云（行为验证码与企业工商四要素核验，后台可切换）
ALIYUN_ACCESS_KEY_ID=your_aliyun_access_key_id
ALIYUN_ACCESS_KEY_SECRET=your_aliyun_access_key_secret
# 阿里云云市场「企业工商四要素核验」接口 AppCode（订阅商品后获取）
ALIYUN_MARKET_APPCODE=your_aliyun_market_appcode

# 6.5 支付证书（PEM，单行 \n 书写；留空则回落证书文件）
# 证书文件化（推荐）：PEM 证书以文件放置，文件存在时优先于本行值
#   certs/alipay/app_private_key.pem、certs/alipay/alipay_public_key.pem、
#   certs/wechat/mch_private_key.pem、certs/wechat/wechat_public_key.pem
ALIPAY_PRIVATE_KEY=your_alipay_private_key
ALIPAY_PUBLIC_KEY=your_alipay_public_key
WECHAT_API_V3_KEY=
WECHAT_MCH_PRIVATE_KEY=
WECHAT_PUBLIC_KEY=

# 6.6 微信一键登录（手机端公众号网页授权 / PC 开放平台网站应用扫码）AppSecret
# AppID 与启用开关在后台「系统设置 → 微信」维护，本文件只放 AppSecret。
# 微信后台须把本站 console 域名登记为「网页授权域名 / 授权回调域」，否则授权回跳报 redirect_uri 参数错误；
# 改 BRAND_ROOT_DOMAIN 后必须同步去微信后台改回跳域名，否则微信登录不可用。
WECHAT_LOGIN_MP_APP_SECRET=
WECHAT_LOGIN_OPEN_APP_SECRET=

# ================
# 7. 订单与端口
# ================
# 待支付订单过期分钟数（默认 30）：超时自动向支付渠道关单撤回并关闭本地订单
PAYMENT_EXPIRE_MINUTES=30

# ================
# 8. 域名证书、TLS 与端口映射
# ================
# 对外域名分发、TLS 终止与 Let's Encrypt 证书签发/续期由宿主机或 1Panel 的 Nginx 统一管理，
# 仓库不内置 certbot。证书文件可置于 ./certs/{fullchain,privkey}.pem 供外部 Nginx 读取（勿提交私钥）。
FRONTEND_PORT=3000